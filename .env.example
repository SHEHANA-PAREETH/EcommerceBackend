PORT=5000
NODE_ENV=development
# MongoDB Atlas or local connection string, including the database name
MONGO_URI=mongodb://127.0.0.1:27017/shopora
# at least 32 random characters in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETKEY=change-me
# the address(es) of the website, comma separated, no trailing slash
CLIENT_SITE_URL=http://localhost:3010
# Stripe test or live secret key (optional: without it only cash on delivery works)
STRIPE_SECRET_KEY=
# Cloudinary for product pictures (optional: without it pictures are saved in public/uploads)
CLOUDINARY_URL=
